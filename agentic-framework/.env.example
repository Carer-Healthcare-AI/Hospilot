# Hospilot Agentic Framework — service configuration
# Copy to .env and fill in. Only HASURA_* are strictly required to boot.
# Every var maps 1:1 to a field in config.py (uppercased).

# ── LLM provider ───────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic                 # anthropic | ollama
ANTHROPIC_API_KEY=
# Self-hosted / OpenAI-compatible fallback (used when LLM_PROVIDER=ollama)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:14b
LLM_FAST_MODEL=
LLM_QUALITY_MODEL=

# ── Primary datastore (Hasura/Postgres) — REQUIRED ──────────────────────────
HASURA_URL=
HASURA_ADMIN_SECRET=

# ── Redis (session/queue/HITL/staging state) ────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── LangGraph durable checkpointer (empty => in-memory; approvals lost on restart)
DATABASE_URL=

# ── Fabric (the data layer agents read/write through) ───────────────────────
FABRIC_BASE_URL=
FABRIC_API_KEY=

# ── Kafka event/relay bus ───────────────────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092

# ── Temporal durable execution plane (optional; off by default) ─────────────
TEMPORAL_ENABLED=false
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hospilot-tasks

# ── Scheduler + approval reaper (recurring autonomous queries) ──────────────
SCHEDULER_ENABLED=true

# ── Autonomous policy engine ────────────────────────────────────────────────
# Code ships with the layer but is left OFF for this staging cut — assisted
# mode (human approvals) is the default path. Flip to true to enable
# auto-approve/escalate on autonomous + scheduled sessions.
AUTONOMOUS_POLICY_ENABLED=false

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=8
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Optional integrations (leave blank to disable) ──────────────────────────
FORECAST_BASE_URL=
FORECAST_API_KEY=
SIM_BASE_URL=
FINANCIAL_API_BASE_URL=
FINANCIAL_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=*
